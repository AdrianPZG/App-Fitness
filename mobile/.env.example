# Copia este archivo a ".env" y llena los valores de tu proyecto Firebase
# (Configuración del proyecto > Tus apps > Web). Sin estos valores la app usa el login de desarrollo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
